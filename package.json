{
  "name": "github-stats",
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive GitHub profile statistics dashboard in your terminal",
  "bin": {
    "github-stats": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src test",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "github",
    "statistics",
    "cli",
    "terminal",
    "dashboard"
  ],
  "license": "MIT",
  "dependencies": {
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "ink": "^4.4.1",
    "react": "^18.3.1",
    "string-width": "^5.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0"
  }
}
