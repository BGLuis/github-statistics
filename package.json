{
  "name": "github-stats",
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive GitHub profile statistics dashboard in your terminal",
  "main": "dist/index.js",
  "bin": {
    "github-stats": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node --esm src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["github", "statistics", "cli", "terminal", "dashboard"],
  "license": "MIT",
  "dependencies": {
    "@octokit/graphql": "^8.1.1",
    "@octokit/rest": "^21.0.2",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "conf": "^13.0.0",
    "dayjs": "^1.11.13",
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
